# Example only — do not put real passwords in the repository.
# Prefer the interactive helper (prompts for all values):
#
#   ./scripts/init_e2e_config.sh
#
# That writes ~/.config/requests-unifi-auth/e2e.env with mode 600.

UNIFI_E2E_HOST=192.168.1.1
UNIFI_E2E_USERNAME=e2e-requests-unifi-auth
UNIFI_E2E_PASSWORD=replace-with-a-long-random-password
UNIFI_E2E_VERIFY_SSL=false
UNIFI_E2E_SKIP_WRITE=false
